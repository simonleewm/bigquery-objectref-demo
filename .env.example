# ==============================================================================
# BigQuery ObjectRef Multimodal Demo — Environment Configuration
# Copy this file to .env and fill in the YOUR_* placeholders (`.env` is git-ignored):
#   cp .env.example .env
# Both `scripts/run_demo.sh` and `Makefile` auto-load `.env` from the repo root.
# ==============================================================================

# 1. Google Cloud Identity & Project
# Exported as CLOUDSDK_CORE_ACCOUNT for every gcloud call. Leave unset or set to
# your active Cloud Shell / gcloud email.
GCLOUD_ACCOUNT=YOUR_GCP_ACCOUNT_EMAIL
GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID

# 2. Region / Location (must match across GCS, BigQuery dataset, and Connection)
GCP_LOCATION=US
GCS_BUCKET_LOCATION=US

# 3. Cloud Storage Bucket (must be globally unique; holds the sample product images)
GCS_BUCKET_NAME=YOUR_GCS_BUCKET_NAME
GCS_IMAGE_PREFIX=product_listings/images

# 4. BigQuery Dataset & Cloud Resource Connection
BQ_DATASET=bq_objectref_demo
BQ_CONNECTION_ID=bq_objectref_demo_gcs_conn

# 5. Gemini Endpoint for AI.IF / AI.CLASSIFY / AI.GENERATE queries (cheapest Flash-Lite tier)
GEMINI_ENDPOINT=gemini-3.5-flash-lite
